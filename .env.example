# Axemere Gateway credentials
# Copy this file to .env and fill in values.
# See docs/gateway-integration.md for setup instructions.

# Required: your gateway token from https://console.axemere.ai
AXEMERE_GATEWAY_TOKEN=your-gateway-token-here

# Required: project ID for workload attribution — used as the fallback for any
# agent role below that doesn't have its own PROJECT_ID_* override.
AXEMERE_PROJECT_ID=your-project-id-here

# Optional: workload ID shared by every agent in this pipeline. One workload
# identifies "the code-review pipeline" as a call site; see [AXEMERE] Workload
# vs project attribution in src/config.ts for why this is separate from project.
# AXEMERE_WORKLOAD_ID=your-workload-id-here

# Optional: per-role project override. Each falls back to AXEMERE_PROJECT_ID
# above when unset, so the demo runs out-of-the-box with just one project.
# Set these to get separate cost/usage attribution per review dimension.
# PROJECT_ID_SECURITY=your-project-id-here
# PROJECT_ID_PERFORMANCE=your-project-id-here
# PROJECT_ID_STYLE=your-project-id-here
# PROJECT_ID_RANKER=your-project-id-here
# PROJECT_ID_SYNTHESIZER=your-project-id-here

# Optional: gateway URL — defaults to http://localhost:7080 (local Docker gateway).
# Set to https://us.gw.axemere.ai for the Axemere managed cloud gateway.
# AXEMERE_GATEWAY_URL=https://us.gw.axemere.ai

# Optional: override default provider and model
# AXEMERE_PROVIDER=openai
# AXEMERE_MODEL=gpt-4o
