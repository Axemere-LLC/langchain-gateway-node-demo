# Axemere Gateway credentials
# Copy this file to .env and fill in values.
# See docs/gateway-integration.md for setup instructions.

# Required: your gateway token from https://console.axemere.ai
AXEMERE_GATEWAY_TOKEN=your-gateway-token-here

# Required: project ID for workload attribution
AXEMERE_PROJECT_ID=your-project-id-here

# Optional: gateway URL — defaults to http://localhost:7080 (local Docker gateway).
# Set to https://us.gw.axemere.ai for the Axemere managed cloud gateway.
# AXEMERE_GATEWAY_URL=https://us.gw.axemere.ai

# Optional: override default provider and model
# AXEMERE_PROVIDER=openai
# AXEMERE_MODEL=gpt-4o
